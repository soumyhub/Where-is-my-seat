# All optional. Copy to backend/.env and fill in what you need.

# Anchor date for the scripted demo stories (default: today + 7 days).
# WIMS_DEMO_DATE=2026-11-06

# Timetable folder under data/: "tag2026" (real, default) or "simulated" (demo).
# WIMS_TIMETABLE=tag2026

# Live seat checks with YOUR OWN RailRadar key (third party, not IRCTC). Sign up yourself at
# https://railradar.in/developers. Seats need their paid Developer plan; a free Sandbox key gets
# "plan upgrade required" for seats (the app then switches live checks off for 24 h).
# WIMS_RAILRADAR_KEY=
# WIMS_LIVE_MONTHLY_LIMIT=90
# WIMS_LIVE_CACHE_MINUTES=30

# Seat availability source: auto (default) | none | simulated | railradar | live
# WIMS_AVAILABILITY_PROVIDER=auto
# WIMS_LIVE_PROVIDER_URL=
# WIMS_LIVE_PROVIDER_KEY=

# Booking window and limits
# WIMS_MAX_ADVANCE_DAYS=60
# WIMS_SEARCH_TIMEOUT_SECONDS=8
# WIMS_STALE_AFTER_MINUTES=360

# Origins allowed to call the API directly (the Next.js /api proxy does not need this).
# WIMS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Override the data folder location.
# WIMS_DATA_DIR=./data
